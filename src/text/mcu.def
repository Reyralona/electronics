/* Texts of the mcu area: boards, their code, the code editor and the serial monitor.
 * Format: UI_TEXT(ID, "pt-BR", "en-US"); style and glossary: docs/TEXTOS.md.
 * Arduino keywords and names (pinMode, HIGH, Serial.print...) are code and stay the same in every language. */

/* Code editor panel. */
UI_TEXT(MCU_EDITOR_TITLE, "Código · %s", "Code · %s")
UI_TEXT(MCU_RUN, "Executar", "Run")
UI_TEXT(MCU_CHANGES_NOT_SENT, "Alterações não enviadas · Ctrl+Enter: executar",
        "Changes not sent · Ctrl+Enter: run")
UI_TEXT(MCU_STATE_RUNNING, "Executando · Ctrl+Espaço: sugestões", "Running · Ctrl+Space: suggestions")
UI_TEXT(MCU_STATE_PAUSED, "Simulação pausada · Espaço: continuar", "Simulation paused · Space: resume")
UI_TEXT(MCU_SERIAL_MONITOR, "Monitor serial", "Serial monitor")
UI_TEXT(MCU_SERIAL_EMPTY, "Serial.println(...) escreve aqui", "Serial.println(...) writes here")

/* Code editor status messages. */
UI_TEXT(MCU_EDITOR_KEYS, "Ctrl+Enter: executar · Ctrl+Espaço: sugestões · Esc: fechar e aplicar",
        "Ctrl+Enter: run · Ctrl+Space: suggestions · Esc: close and apply")
UI_TEXT(MCU_CODE_NO_MEMORY, "Sem memória para o código novo. A placa continua com o código anterior.",
        "Not enough memory for the new code. The board keeps the previous code.")
UI_TEXT(MCU_CODE_SENT, "Código enviado. A placa reiniciou. Ctrl+Z: desfazer",
        "Code sent. The board restarted. Ctrl+Z: undo")
UI_TEXT(MCU_CODE_APPLIED, "Código aplicado. Ctrl+Z: desfazer", "Code applied. Ctrl+Z: undo")
UI_TEXT(MCU_EDITOR_CLOSED, "Editor de código fechado.", "Code editor closed.")
UI_TEXT(MCU_BOARD_GONE, "A placa foi apagada ou trocada. O editor de código fechou.",
        "The board was deleted or replaced. The code editor closed.")
UI_TEXT(MCU_CODE_FULL, "O código chegou ao limite de %d KB. Apague texto para continuar.",
        "The code is at the limit of %d KB. Delete text to continue.")
UI_TEXT(MCU_NO_CHANGES, "Nenhuma alteração. A placa continua com o mesmo código.",
        "No changes. The board keeps the same code.")

/* Comment on the first line of a new board's code. */
UI_TEXT(MCU_DEFAULT_UNO, "Pisca o LED da placa (pino 13)", "Blinks the LED on the board (pin 13)")
UI_TEXT(MCU_DEFAULT_ESP32, "ESP32: LED no GPIO 2", "ESP32: LED on GPIO 2")
UI_TEXT(MCU_DEFAULT_ATTINY85, "ATtiny85: alimente VCC (pino 8) e GND (pino 4)",
        "ATtiny85: power VCC (pin 8) and GND (pin 4)")

/* Code errors. The reason goes in the line text; it says what is wrong and how to correct it. */
UI_TEXT(MCU_ERROR_LINE, "Linha %d: %s", "Line %d: %s")
UI_TEXT(MCU_ERROR_STOPPED, "Programa parado: %s", "Program stopped: %s")
UI_TEXT(MCU_ERROR_MISSING, "falta '%s' antes de '%s'.", "missing '%s' before '%s'.")
UI_TEXT(MCU_ERROR_MISSING_AT_END, "falta '%s' no fim do código.", "missing '%s' at the end of the code.")
UI_TEXT(MCU_ERROR_NO_MEMORY, "não há memória para o código.", "not enough memory for the code.")
UI_TEXT(MCU_ERROR_VALUE_COUNT, "%s precisa de %d a %d valores entre parênteses.",
        "%s needs %d to %d values in parentheses.")
UI_TEXT(MCU_ERROR_MEMBER_VALUE_COUNT, "%s.%s: número errado de valores.", "%s.%s: wrong number of values.")
UI_TEXT(MCU_ERROR_UNDECLARED, "'%s' não foi declarado. Declare antes de usar.",
        "'%s' is not declared. Declare it first.")
UI_TEXT(MCU_ERROR_UNKNOWN_METHOD, "'%s' não existe no simulador.", "'%s' is not available in the simulator.")
UI_TEXT(MCU_ERROR_TOO_MANY_FUNCTIONS, "funções demais. O limite é %d.", "too many functions. The limit is %d.")
UI_TEXT(MCU_ERROR_BAD_EXPRESSION, "expressão inválida perto de '%s'.", "invalid expression near '%s'.")
UI_TEXT(MCU_ERROR_INCREMENT, "++ e -- só funcionam com uma variável.", "++ and -- work only with a variable.")
UI_TEXT(MCU_ERROR_TOO_MANY_VARIABLES, "variáveis demais. O limite é %d.", "too many variables. The limit is %d.")
UI_TEXT(MCU_ERROR_VARIABLE_MEMORY, "variáveis ocupam memória demais. Use vetores menores.",
        "variables use too much memory. Use smaller arrays.")
UI_TEXT(MCU_ERROR_TOO_MANY_VALUES, "valores demais para o vetor '%s'.", "too many values for the array '%s'.")
UI_TEXT(MCU_ERROR_ARRAY_SIZE, "tamanho de vetor inválido. Use um número maior que 0.",
        "invalid array size. Use a number greater than 0.")
UI_TEXT(MCU_ERROR_TOO_MANY_LOOPS, "laços demais um dentro do outro. O limite é %d.",
        "too many loops inside each other. The limit is %d.")
UI_TEXT(MCU_ERROR_OUTSIDE_LOOP, "'%s' fora de um laço.", "'%s' outside a loop.")
UI_TEXT(MCU_ERROR_DUPLICATE_FUNCTION, "a função '%s' aparece duas vezes. Apague uma.",
        "function '%s' is written two times. Delete one.")
UI_TEXT(MCU_ERROR_TOO_MANY_LCDS, "LCDs demais. O limite é %d.", "too many LCDs. The limit is %d.")
UI_TEXT(MCU_ERROR_UNEXPECTED, "'%s' inesperado fora de uma função.", "unexpected '%s' outside a function.")
UI_TEXT(MCU_ERROR_NAME_MISSING, "falta um nome.", "missing name.")
UI_TEXT(MCU_ERROR_NO_SETUP_LOOP, "o programa precisa de void setup() e void loop().",
        "the program needs void setup() and void loop().")
UI_TEXT(MCU_ERROR_UNDEFINED_FUNCTION, "falta a função '%s'.", "missing function '%s'.")
UI_TEXT(MCU_ERROR_CALL_DEPTH, "funções demais chamadas uma dentro da outra.",
        "too many function calls inside each other.")
UI_TEXT(MCU_ERROR_ARRAY_INDEX, "posição fora do vetor.", "position outside the array.")
UI_TEXT(MCU_ERROR_RETURN, "return sem chamada de função.", "return without a function call.")
UI_TEXT(MCU_ERROR_PROGRAM_END, "o programa terminou de forma inesperada.", "the program ended unexpectedly.")

/* Completion help: signature (parameter names translated) and what the name does. */
UI_TEXT(MCU_SIG_PINMODE, "pinMode(pino, INPUT | OUTPUT | INPUT_PULLUP)", "pinMode(pin, INPUT | OUTPUT | INPUT_PULLUP)")
UI_TEXT(MCU_HELP_PINMODE, "Define o pino como entrada ou saída", "Sets the pin as input or output")
UI_TEXT(MCU_SIG_DIGITALWRITE, "digitalWrite(pino, HIGH | LOW)", "digitalWrite(pin, HIGH | LOW)")
UI_TEXT(MCU_HELP_DIGITALWRITE, "Liga ou desliga uma saída digital", "Turns a digital output on or off")
UI_TEXT(MCU_SIG_DIGITALREAD, "digitalRead(pino)", "digitalRead(pin)")
UI_TEXT(MCU_HELP_DIGITALREAD, "Lê HIGH ou LOW de uma entrada", "Reads HIGH or LOW from an input")
UI_TEXT(MCU_SIG_ANALOGREAD, "analogRead(pino)", "analogRead(pin)")
UI_TEXT(MCU_HELP_ANALOGREAD, "Lê a tensão do pino (0–1023; ESP32: 0–4095)",
        "Reads the pin voltage (0–1023; ESP32: 0–4095)")
UI_TEXT(MCU_SIG_ANALOGWRITE, "analogWrite(pino, 0..255)", "analogWrite(pin, 0..255)")
UI_TEXT(MCU_HELP_ANALOGWRITE, "PWM, simulado como tensão média", "PWM, simulated as average voltage")
UI_TEXT(MCU_SIG_DELAY, "delay(ms)", "delay(ms)")
UI_TEXT(MCU_HELP_DELAY, "Pausa o programa, em milissegundos", "Pauses the program, in milliseconds")
UI_TEXT(MCU_SIG_DELAYMICROSECONDS, "delayMicroseconds(us)", "delayMicroseconds(us)")
UI_TEXT(MCU_HELP_DELAYMICROSECONDS, "Pausa o programa, em microssegundos", "Pauses the program, in microseconds")
UI_TEXT(MCU_SIG_MILLIS, "millis()", "millis()")
UI_TEXT(MCU_HELP_MILLIS, "Milissegundos desde o início", "Milliseconds since start")
UI_TEXT(MCU_SIG_MICROS, "micros()", "micros()")
UI_TEXT(MCU_HELP_MICROS, "Microssegundos desde o início", "Microseconds since start")
UI_TEXT(MCU_SIG_MAP, "map(valor, deMin, deMax, paraMin, paraMax)", "map(value, fromLow, fromHigh, toLow, toHigh)")
UI_TEXT(MCU_HELP_MAP, "Converte um valor de uma faixa para outra", "Converts a value from one range to another")
UI_TEXT(MCU_SIG_CONSTRAIN, "constrain(valor, min, max)", "constrain(value, min, max)")
UI_TEXT(MCU_HELP_CONSTRAIN, "Mantém um valor entre min e max", "Keeps a value between min and max")
UI_TEXT(MCU_SIG_MIN, "min(a, b)", "min(a, b)")
UI_TEXT(MCU_HELP_MIN, "Menor valor", "Smaller value")
UI_TEXT(MCU_SIG_MAX, "max(a, b)", "max(a, b)")
UI_TEXT(MCU_HELP_MAX, "Maior valor", "Larger value")
UI_TEXT(MCU_SIG_ABS, "abs(x)", "abs(x)")
UI_TEXT(MCU_HELP_ABS, "Valor absoluto", "Absolute value")
UI_TEXT(MCU_SIG_RANDOM, "random(max) | random(min, max)", "random(max) | random(min, max)")
UI_TEXT(MCU_HELP_RANDOM, "Número aleatório", "Random number")
UI_TEXT(MCU_SIG_RANDOMSEED, "randomSeed(semente)", "randomSeed(seed)")
UI_TEXT(MCU_HELP_RANDOMSEED, "Define a semente dos números aleatórios", "Sets the seed of the random numbers")
UI_TEXT(MCU_SIG_SQRT, "sqrt(x)", "sqrt(x)")
UI_TEXT(MCU_HELP_SQRT, "Raiz quadrada", "Square root")
UI_TEXT(MCU_SIG_POW, "pow(base, expoente)", "pow(base, exponent)")
UI_TEXT(MCU_HELP_POW, "Base elevada ao expoente", "Base raised to the exponent")
UI_TEXT(MCU_SIG_TONE, "tone(pino, frequência)", "tone(pin, frequency)")
UI_TEXT(MCU_HELP_TONE, "Gera um tom (simulado como onda quadrada)", "Makes a tone (simulated as a square wave)")
UI_TEXT(MCU_SIG_NOTONE, "noTone(pino)", "noTone(pin)")
UI_TEXT(MCU_HELP_NOTONE, "Para o tom", "Stops the tone")
UI_TEXT(MCU_SIG_SERIAL_BEGIN, "Serial.begin(9600)", "Serial.begin(9600)")
UI_TEXT(MCU_HELP_SERIAL_BEGIN, "Liga o monitor serial", "Starts the serial monitor")
UI_TEXT(MCU_SIG_SERIAL_PRINT, "Serial.print(valor)", "Serial.print(value)")
UI_TEXT(MCU_HELP_SERIAL_PRINT, "Escreve no monitor serial", "Writes to the serial monitor")
UI_TEXT(MCU_SIG_SERIAL_PRINTLN, "Serial.println(valor)", "Serial.println(value)")
UI_TEXT(MCU_HELP_SERIAL_PRINTLN, "Escreve e muda de linha", "Writes and starts a new line")
UI_TEXT(MCU_SIG_LCD_DECLARE, "LiquidCrystal_I2C lcd(0x27, 16, 2);", "LiquidCrystal_I2C lcd(0x27, 16, 2);")
UI_TEXT(MCU_HELP_LCD_DECLARE, "Declara um LCD I2C de 16x2", "Declares a 16x2 I2C LCD")
UI_TEXT(MCU_SIG_LCD_INIT, "lcd.init()", "lcd.init()")
UI_TEXT(MCU_HELP_LCD_INIT, "Liga o LCD", "Starts the LCD")
UI_TEXT(MCU_SIG_LCD_BACKLIGHT, "lcd.backlight()", "lcd.backlight()")
UI_TEXT(MCU_HELP_LCD_BACKLIGHT, "Liga a luz de fundo", "Turns on the backlight")
UI_TEXT(MCU_SIG_LCD_CLEAR, "lcd.clear()", "lcd.clear()")
UI_TEXT(MCU_HELP_LCD_CLEAR, "Apaga o texto do LCD", "Clears the LCD text")
UI_TEXT(MCU_SIG_LCD_SETCURSOR, "lcd.setCursor(coluna, linha)", "lcd.setCursor(column, row)")
UI_TEXT(MCU_HELP_LCD_SETCURSOR, "Move o cursor", "Moves the cursor")
UI_TEXT(MCU_SIG_LCD_PRINT, "lcd.print(valor)", "lcd.print(value)")
UI_TEXT(MCU_HELP_LCD_PRINT, "Escreve no LCD", "Writes to the LCD")
UI_TEXT(MCU_SIG_SETUP, "void setup() { }", "void setup() { }")
UI_TEXT(MCU_HELP_SETUP, "Executa uma vez no início", "Runs one time at start")
UI_TEXT(MCU_SIG_LOOP, "void loop() { }", "void loop() { }")
UI_TEXT(MCU_HELP_LOOP, "Executa sem parar, depois de setup()", "Runs again and again after setup()")
UI_TEXT(MCU_SIG_HIGH, "HIGH", "HIGH")
UI_TEXT(MCU_HELP_HIGH, "Nível alto (1)", "High level (1)")
UI_TEXT(MCU_SIG_LOW, "LOW", "LOW")
UI_TEXT(MCU_HELP_LOW, "Nível baixo (0)", "Low level (0)")
UI_TEXT(MCU_SIG_OUTPUT, "OUTPUT", "OUTPUT")
UI_TEXT(MCU_HELP_OUTPUT, "Modo de saída", "Output mode")
UI_TEXT(MCU_SIG_INPUT, "INPUT", "INPUT")
UI_TEXT(MCU_HELP_INPUT, "Modo de entrada", "Input mode")
UI_TEXT(MCU_SIG_INPUT_PULLUP, "INPUT_PULLUP", "INPUT_PULLUP")
UI_TEXT(MCU_HELP_INPUT_PULLUP, "Entrada com pull-up interno", "Input with internal pull-up")
UI_TEXT(MCU_SIG_LED_BUILTIN, "LED_BUILTIN", "LED_BUILTIN")
UI_TEXT(MCU_HELP_LED_BUILTIN, "LED da placa", "LED on the board")
UI_TEXT(MCU_SIG_FOR, "for (int i = 0; i < n; i++) { }", "for (int i = 0; i < n; i++) { }")
UI_TEXT(MCU_HELP_FOR, "Repete um número de vezes", "Repeats a number of times")
UI_TEXT(MCU_SIG_WHILE, "while (condição) { }", "while (condition) { }")
UI_TEXT(MCU_HELP_WHILE, "Repete enquanto a condição é verdadeira", "Repeats while the condition is true")
UI_TEXT(MCU_SIG_IF, "if (condição) { } else { }", "if (condition) { } else { }")
UI_TEXT(MCU_HELP_IF, "Escolhe o caminho pela condição", "Chooses the path by the condition")
UI_TEXT(MCU_SIG_INT, "int nome = valor;", "int name = value;")
UI_TEXT(MCU_HELP_INT, "Número inteiro", "Whole number")
UI_TEXT(MCU_SIG_FLOAT, "float nome = valor;", "float name = value;")
UI_TEXT(MCU_HELP_FLOAT, "Número com casas decimais", "Number with decimals")
