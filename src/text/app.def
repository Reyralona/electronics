UI_TEXT(APP_PART_DELETED, "Peça e seus fios apagados.", "Part and its wires deleted.")
UI_TEXT(APP_WIRE_DELETED, "Fio apagado.", "Wire deleted.")
UI_TEXT(APP_CHIP_ACTION_UNAVAILABLE, "Esta ação não vale para chips. Ctrl+Shift+G: desagrupar o chip.",
