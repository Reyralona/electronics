UI_TEXT(APP_TRANSPARENCY_OFF, "Transparência desligada.", "Transparency off.")

/* Selection, clipboard and project slots. */
UI_TEXT(APP_SELECTION_COPIED, "Seleção copiada. Ctrl+V: colar no ponteiro.",
        "Selection copied. Ctrl+V: paste at the pointer.")
UI_TEXT(APP_SELECT_TO_COPY, "Selecione peças para copiar.", "Select parts to copy.")
UI_TEXT(APP_SELECTION_DELETED, "Seleção e seus fios apagados. Ctrl+Z: desfazer.",
        "Selection and its wires deleted. Ctrl+Z: undo.")
UI_TEXT(APP_NO_ROOM, "Não cabe na bancada. Limite: %d peças e %d fios.",
        "Does not fit on the bench. Limit: %d parts and %d wires.")
UI_TEXT(APP_NOTHING_TO_PASTE, "Nada para colar. Ctrl+C: copiar uma seleção.", "Nothing to paste. Ctrl+C: copy a selection.")
UI_TEXT(APP_SELECTION_PASTED, "Seleção colada.", "Selection pasted.")
UI_TEXT(APP_ALL_SELECTED, "Todas as peças selecionadas.", "All parts selected.")
UI_TEXT(APP_PARTS_SELECTED, "%d peças selecionadas.", "%d parts selected.")
UI_TEXT(APP_PROJECT_FOLDER_FAILED, "Não foi possível criar a pasta dos projetos: %s",
