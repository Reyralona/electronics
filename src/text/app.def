/* Simulation results. */
UI_TEXT(APP_BURN_SOURCE_SHORT, "Fonte queimada por curto-circuito. Corrija a ligação para ela funcionar de novo.",
        "Source burned by a short circuit. Correct the connection to make it work again.")
UI_TEXT(APP_BURN_CLOCK_SHORT, "Clock queimado por curto-circuito. Corrija a ligação para ele funcionar de novo.",
        "Clock burned by a short circuit. Correct the connection to make it work again.")
UI_TEXT(APP_BURN_RESISTOR, "Resistor queimado: %.3g W (limite %.3g W). Corrija o circuito para ele funcionar de novo.",
        "Resistor burned: %.3g W (limit %.3g W). Correct the circuit to make it work again.")
UI_TEXT(APP_BURN_LED, "LED queimado: %.3g mA (limite %.3g mA). Use um resistor em série.",
