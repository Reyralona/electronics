UI_TEXT(APP_CHIP_FILE_UNAVAILABLE, "Arquivo indisponível", "File not available")
UI_TEXT(APP_LIBRARY_FOLDER_FAILED, "Não foi possível criar a pasta da biblioteca: %s",
