UI_TEXT(APP_CLICK_TO_PLACE_CHIP, "Clique na bancada para colocar o chip.", "Click the bench to place the chip.")
UI_TEXT(APP_CHIP_PLACED, "Chip colocado. Ligue os terminais.", "Chip placed. Connect its terminals.")
UI_TEXT(APP_CONFIRM_REMOVE_CHIP, "Clique de novo no x para remover \"%.60s\" da biblioteca.",
