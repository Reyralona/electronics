/* Texts of the app area: actions and status line messages. Format: UI_TEXT(ID, "pt-BR", "en-US"); style and
 * glossary: docs/TEXTOS.md. */
UI_TEXT(APP_START, "Escolha uma peça no catálogo e clique na bancada.", "Select a part in the catalog and click the bench.")
UI_TEXT(APP_OUT_OF_MEMORY, "Memória insuficiente. A montagem não mudou.", "Not enough memory. The circuit did not change.")
UI_TEXT(APP_HISTORY_FAILED, "Não foi possível registrar a ação para desfazer. A montagem não mudou.",
        "Cannot record the action for undo. The circuit did not change.")
UI_TEXT(APP_TEXT_INPUT_FAILED, "Não foi possível abrir a entrada de texto.", "Cannot open the text input.")

/* Commands: examples, catalog pages, view, undo, simulation. */
UI_TEXT(APP_EXAMPLE_FAILED, "Não foi possível carregar o exemplo.", "Cannot load the example.")
UI_TEXT(APP_PAGE_BASIC, "Peças básicas.", "Basic parts.")
UI_TEXT(APP_PAGE_LOGIC, "Portas lógicas, CIs, placas e LCD.", "Logic gates, ICs, boards and LCD.")
UI_TEXT(APP_PAGE_CHIPS, "Chips salvos. Ctrl+G: criar chip.", "Saved chips. Ctrl+G: create chip.")
UI_TEXT(APP_PAGE_SENSORS, "Sensores com controle de ambiente.", "Sensors with environment control.")
UI_TEXT(APP_PAGE_OUTPUTS, "Saídas: lâmpada, LED RGB, display, motores, servo e piezo.",
