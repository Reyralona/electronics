UI_TEXT(APP_CHIP_SAVE_FAILED, "Não foi possível salvar o chip: %s", "Cannot save the chip: %s")
UI_TEXT(APP_CHIP_UNPACKED, "Chip desagrupado. Os fios externos continuam nos mesmos terminais.",
