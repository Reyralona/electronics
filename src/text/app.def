/* Chips: create, edit, rename, library. */
UI_TEXT(APP_SELECT_CHIP_TO_EDIT, "Selecione um chip na bancada para editar.", "Select a chip on the bench to edit it.")
UI_TEXT(APP_EDITOR_NO_MEMORY, "Memória insuficiente para abrir o editor do chip.",
        "Not enough memory to open the chip editor.")
UI_TEXT(APP_EDITOR_COPY_FAILED, "Não foi possível copiar o chip para o editor.", "Cannot copy the chip into the editor.")
UI_TEXT(APP_EDITOR_OPENED, "Editor do chip. Salvar: atualiza a biblioteca · Aplicar: muda a bancada.",
        "Chip editor. Save: update the library · Apply: change the bench.")
UI_TEXT(APP_EDITOR_NO_PROJECTS, "Projetos indisponíveis no editor do chip. Use Salvar.",
        "Projects are not available in the chip editor. Use Save.")
UI_TEXT(APP_NAME_INVALID, "Nome inválido ou longo demais. Use até %d bytes, sem caracteres de controle.",
        "Name invalid or too long. Use up to %d bytes, without control characters.")
UI_TEXT(APP_SELECT_CHIP_TO_RENAME, "Abra o chip e clique em Renomear.", "Open the chip and click Rename.")
UI_TEXT(APP_TYPE_CHIP_NAME, "Digite o nome do chip. Enter: confirmar · Esc: cancelar.",
