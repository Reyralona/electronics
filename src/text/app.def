UI_TEXT(APP_PROJECT_SAVED, "Projeto salvo no slot %d.", "Project saved in slot %d.")
UI_TEXT(APP_PROJECT_SAVE_FAILED, "Não foi possível salvar no slot %d. O arquivo anterior não mudou.",
