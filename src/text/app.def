UI_TEXT(APP_NAME_CHANGED, "Nome alterado. Salve para manter.", "Name changed. Save to keep it.")
UI_TEXT(APP_RENAME_CANCELED, "Renomeação cancelada.", "Rename canceled.")
UI_TEXT(APP_LIBRARY_FULL, "Biblioteca cheia (%d chips). Remova um chip e salve de novo.",
