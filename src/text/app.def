UI_TEXT(APP_CALCULATING_CURVE, "Calculando a curva no tempo...", "Calculating the curve over time...")
UI_TEXT(APP_CALCULATING_DC, "Calculando o ponto de operação DC...", "Calculating the DC operating point...")
UI_TEXT(APP_NO_SUCH_TERMINAL, "Esta peça não tem este terminal.", "This part does not have this terminal.")
UI_TEXT(APP_GATE_CURRENT_UNAVAILABLE, "Não é possível medir a corrente interna de uma porta.",
