UI_TEXT(APP_SIMULATION_START_FAILED, "Não foi possível iniciar a simulação.", "Cannot start the simulation.")
UI_TEXT(APP_CHANGED_WHILE_PAUSED, "Circuito alterado. Espaço: continuar a simulação.",
