UI_TEXT(APP_VIEW_RESET, "Vista inicial restaurada.", "Default view restored.")
UI_TEXT(APP_UNDONE, "Ação desfeita.", "Action undone.")
UI_TEXT(APP_REDONE, "Ação refeita.", "Action redone.")
UI_TEXT(APP_NOTHING_TO_UNDO, "Nada para desfazer.", "Nothing to undo.")
UI_TEXT(APP_NOTHING_TO_REDO, "Nada para refazer.", "Nothing to redo.")
UI_TEXT(APP_SELECTION_CANCELED, "Seleção cancelada.", "Selection canceled.")
UI_TEXT(APP_PLAYING_CURVE, "Reproduzindo a curva em 5 s.", "Playing the curve in 5 s.")
UI_TEXT(APP_SIM_RUNNING, "Simulação em execução.", "Simulation running.")
UI_TEXT(APP_SIM_PAUSED, "Simulação pausada. Espaço: continuar.", "Simulation paused. Space: resume.")
UI_TEXT(APP_PLAYBACK_PAUSED, "Reprodução pausada. B: anterior · N: próxima.", "Playback paused. B: previous · N: next.")
UI_TEXT(APP_RECALCULATING, "Recalculando o circuito...", "Recalculating the circuit...")
UI_TEXT(APP_RESETTING, "Reiniciando o estado elétrico...", "Resetting the electrical state...")
UI_TEXT(APP_PART_ROTATED, "Peça girada.", "Part rotated.")
UI_TEXT(APP_BOARD_NO_ROTATE, "Esta placa não gira.", "This board cannot rotate.")
UI_TEXT(APP_GRAPH_SHOWN, "Gráfico visível.", "Graph shown.")
UI_TEXT(APP_GRAPH_HIDDEN, "Gráfico oculto. G: mostrar.", "Graph hidden. G: show.")
UI_TEXT(APP_CALCULATION_BUSY, "Cálculo em andamento. Aguarde o resultado.", "Calculation in progress. Wait for the result.")
