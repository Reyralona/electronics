UI_TEXT(APP_SELECT_CHIP_TO_UNPACK, "Selecione um chip para desagrupar.", "Select a chip to ungroup.")
UI_TEXT(APP_CHIP_CREATED, "Chip criado.", "Chip created.")
UI_TEXT(APP_CHIP_CREATED_NOT_SAVED, "Chip criado, mas a biblioteca está cheia. Ele não foi salvo.",
