UI_TEXT(APP_CALCULATION_FAILED, "Não foi possível calcular: %s", "Cannot calculate: %s")
UI_TEXT(APP_LIVE_RESTARTED, "Ligações ou frequência mudaram. Estado elétrico reiniciado.",
