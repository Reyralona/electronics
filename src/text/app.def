UI_TEXT(APP_CHIP_REMOVE_FAILED, "Não foi possível remover o chip: %s", "Cannot remove the chip: %s")
UI_TEXT(APP_CHIP_REMOVED, "Chip removido da biblioteca. Cópia na pasta lixeira; a bancada não mudou.",
