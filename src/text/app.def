UI_TEXT(APP_NO_VALUE, "Esta peça não tem valor.", "This part has no value.")
UI_TEXT(APP_VALUE_CHANGED, "Valor alterado.", "Value changed.")
UI_TEXT(APP_VALUE_OUT_OF_RANGE, "Valor fora do limite. O valor não mudou.", "Value out of range. The value did not change.")
UI_TEXT(APP_VALUE_INVALID, "Valor inválido. Use um número positivo de 1e-12 a 1e12.",
