UI_TEXT(APP_CURVE_DISCARDED, "Circuito alterado. Curva descartada.", "Circuit changed. Curve discarded.")
UI_TEXT(APP_CHANGED_PRESS_P, "Circuito alterado. P: calcular de novo.", "Circuit changed. P: calculate again.")
UI_TEXT(APP_CURVE_PLAY_FAILED, "Não foi possível reproduzir a curva.", "Cannot play the curve.")
UI_TEXT(APP_CURVE_END, "Fim da curva. Espaço: repetir · B: voltar.", "End of curve. Space: replay · B: back.")

